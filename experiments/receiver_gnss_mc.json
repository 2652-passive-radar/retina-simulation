{
  "name": "receiver-gnss-mc",
  "description": "Step 3d of the receiver-motion study: Monte Carlo sensitivity of GD (receiver pose from the step 3b KF) to each GNSS-model and receiver-KF parameter, one at a time from nominal, plus a sigma_corr x tau grid. GNSS sweeps keep the KF matched to the GNSS; the filter sweeps detune the KF from a nominal GNSS. Output: the value of each parameter at which GD's aircraft position or velocity RMSE rises 5/10/20% above GD with the true trajectory. Condensed (2026-11-13): levels on the benign side of nominal dropped, the warm-up ticks not solved, 2 realisations per seed in the three cases GNSS error barely moves; a linearised surrogate (gnss_linear.py) was tried and rejected.",
  "base": "receiver_gnss.json",
  "case_ids": [
    "static",
    "oscillate-walk",
    "linear-east-vehicle",
    "oscillate-vehicle",
    "circle-vehicle"
  ],
  "method": "full",
  "linear": {
    "realisations": 50,
    "h_pos_m": 2.0,
    "h_vel_ms": 0.5,
    "validate_levels": "sigma_white"
  },
  "realisations": 4,
  "screen_realisations": 8,
  "thresholds_pct": [
    5,
    10,
    20
  ],
  "sweeps": [
    {
      "id": "sigma_white",
      "key": "gnss.sigma_white_m",
      "label": "GNSS white noise \u03c3_white",
      "unit": "m",
      "levels": [
        0.1,
        0.25,
        1,
        2,
        4,
        8,
        16,
        32
      ]
    },
    {
      "id": "sigma_corr",
      "key": "gnss.sigma_corr_m",
      "label": "GNSS correlated error \u03c3_corr",
      "unit": "m",
      "levels": [
        3,
        6,
        12,
        24,
        48
      ]
    },
    {
      "id": "tau",
      "key": "gnss.tau_s",
      "label": "GNSS correlation time \u03c4",
      "unit": "s",
      "levels": [
        5,
        15,
        30,
        300
      ]
    },
    {
      "id": "rate",
      "key": "gnss.rate_hz",
      "label": "GNSS fix rate",
      "unit": "Hz",
      "levels": [
        0.1,
        0.2,
        0.5,
        10
      ]
    },
    {
      "id": "time_offset",
      "key": "gnss.time_offset_s",
      "label": "GNSS time offset (unknown to the KF)",
      "unit": "s",
      "levels": [
        0.1,
        0.2,
        0.5,
        1,
        2
      ]
    },
    {
      "id": "latency",
      "key": "gnss.latency_s",
      "label": "GNSS latency (known to the KF)",
      "unit": "s",
      "levels": [
        0.25,
        0.5,
        1,
        2,
        5
      ]
    },
    {
      "id": "sigma_a",
      "key": "filter.sigma_a_scale",
      "label": "KF \u03c3_a (\u00d7 platform-mode value)",
      "unit": "\u00d7",
      "levels": [
        0.1,
        0.25,
        0.5,
        4,
        10
      ]
    },
    {
      "id": "assumed_sigma",
      "key": "filter.assumed_sigma_scale",
      "label": "KF assumed \u03c3_white, \u03c3_corr (\u00d7 true)",
      "unit": "\u00d7",
      "levels": [
        0.25,
        2,
        4
      ]
    },
    {
      "id": "assumed_tau",
      "key": "filter.assumed_tau_scale",
      "label": "KF assumed \u03c4 (\u00d7 true)",
      "unit": "\u00d7",
      "levels": [
        0.1,
        0.3
      ]
    }
  ],
  "grid": {
    "x": "gnss.sigma_corr_m",
    "y": "gnss.tau_s",
    "x_label": "\u03c3_corr (m)",
    "y_label": "\u03c4 (s)",
    "x_levels": [
      1.5,
      6,
      24
    ],
    "y_levels": [
      15,
      60,
      300
    ]
  },
  "case_realisations": {
    "static": 2,
    "oscillate-walk": 2,
    "linear-east-vehicle": 2
  }
}
